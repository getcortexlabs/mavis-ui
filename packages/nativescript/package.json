{
  "name": "@getcortexlabs/mavis",
  "version": "0.1.0-rc.14",
  "description": "Mavis UI foundations and direct NativeScript framework integrations.",
  "type": "module",
  "sideEffects": [
    "./dist/vue/components/layout.js",
    "./src/vue/components/layout.ts",
    "./dist/react/index.js",
    "./src/react/index.ts",
    "./dist/angular/index.js",
    "./src/angular/index.ts",
    "./dist/svelte/index.js",
    "./src/svelte/index.ts",
    "./dist/solid/index.js",
    "./src/solid/index.ts",
    "./dist/svelte/register.js",
    "./src/svelte/register.ts"
  ],
  "exports": {
    "./app-icons": {
      "types": "./dist/app-icons.d.ts",
      "default": "./dist/app-icons.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./vue/services": {
      "types": "./dist/vue/services.d.ts",
      "default": "./dist/vue/services.js"
    },
    "./date-format": {
      "types": "./dist/date-format.d.ts",
      "default": "./dist/date-format.js"
    },
    "./native": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "platforms/android/include.gradle",
    "platforms/android/java",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ngc -p tsconfig.angular.json && node ../../scripts/build-svelte-adapter.mjs"
  },
  "peerDependencies": {
    "@nativescript/core": "^9.1.3",
    "@rafaelaugusto/jolt": "^0.1.0-rc.16",
    "nativescript-vue": "^3.1.3",
    "react": "^18.3.1",
    "react-nativescript": "^5.0.0",
    "@angular/core": "^22.3.0",
    "@nativescript/angular": "^22.0.2",
    "svelte": "4.2.20",
    "@nativescript-community/svelte-native": "1.0.32",
    "solid-js": "^2.0.0",
    "@nativescript-community/solid-js": "^2.0.1",
    "dominative": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "nativescript-vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-nativescript": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@nativescript/angular": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@nativescript-community/svelte-native": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@nativescript-community/solid-js": {
      "optional": true
    },
    "dominative": {
      "optional": true
    }
  },
  "dependencies": {
    "@getcortexlabs/mavis-core": "0.1.0-rc.14"
  },
  "nativescript": {
    "platforms": {
      "android": "9.1.1",
      "ios": "9.1.0"
    }
  },
  "license": "MIT",
  "author": "Rafael Augusto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcortexlabs/mavis-ui.git",
    "directory": "packages/nativescript"
  },
  "homepage": "https://mavis-ui.getcortexlabs.com/guide/foundation",
  "bugs": {
    "url": "https://github.com/getcortexlabs/mavis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mavis",
    "ui",
    "themes",
    "vue",
    "nativescript"
  ]
}
