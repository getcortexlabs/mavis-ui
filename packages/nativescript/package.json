{
  "name": "@getcortexlabs/mavis",
  "version": "0.1.0-alpha.1",
  "description": "Mavis UI foundations for NativeScript, with a Vue integration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "platforms/android/include.gradle",
    "platforms/android/java",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@nativescript/core": "^9.1.3",
    "@rafaelaugusto/jolt": "^0.1.0-rc.1",
    "nativescript-vue": "^3.1.3"
  },
  "peerDependenciesMeta": {
    "nativescript-vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@getcortexlabs/mavis-core": "0.1.0-alpha.1"
  },
  "nativescript": {
    "platforms": {
      "android": "9.1.1",
      "ios": "9.1.0"
    }
  },
  "license": "MIT",
  "author": "Rafael Augusto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcortexlabs/mavis-ui.git",
    "directory": "packages/nativescript"
  },
  "homepage": "https://mavis-ui.getcortexlabs.com/guide/foundation",
  "bugs": {
    "url": "https://github.com/getcortexlabs/mavis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mavis",
    "ui",
    "themes",
    "vue",
    "nativescript"
  ]
}
