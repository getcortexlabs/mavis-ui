{
  "name": "@getcortexlabs/mavis-web",
  "version": "0.1.0-rc.13",
  "description": "Mavis components for Vue Web.",
  "type": "module",
  "sideEffects": [
    "./src/style.css",
    "./src/base.css",
    "./src/icons.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./src/style.d.ts",
      "default": "./src/style.css"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "default": "./dist/services.js"
    },
    "./base.css": {
      "types": "./src/style.d.ts",
      "default": "./src/base.css"
    },
    "./icons.css": {
      "types": "./src/style.d.ts",
      "default": "./src/icons.css"
    },
    "./date-format": {
      "types": "./dist/date-format.d.ts",
      "default": "./dist/date-format.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@getcortexlabs/mavis-core": "0.1.0-rc.13"
  },
  "peerDependencies": {
    "vue": "^3.5.42",
    "@rafaelaugusto/jolt": "^0.1.0-rc.15"
  },
  "license": "MIT",
  "author": "Rafael Augusto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcortexlabs/mavis-ui.git",
    "directory": "packages/web"
  },
  "homepage": "https://mavis-ui.getcortexlabs.com/guide/web",
  "bugs": {
    "url": "https://github.com/getcortexlabs/mavis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mavis",
    "ui",
    "themes",
    "vue"
  ]
}
