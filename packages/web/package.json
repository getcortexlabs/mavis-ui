{
  "name": "@getcortexlabs/mavis-web",
  "version": "0.1.0-alpha.3",
  "description": "Mavis components for Vue Web.",
  "type": "module",
  "sideEffects": [
    "./src/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./src/style.d.ts",
      "default": "./src/style.css"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@getcortexlabs/mavis-core": "0.1.0-alpha.3"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "license": "MIT",
  "author": "Rafael Augusto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcortexlabs/mavis-ui.git",
    "directory": "packages/web"
  },
  "homepage": "https://mavis-ui.getcortexlabs.com/guide/web",
  "bugs": {
    "url": "https://github.com/getcortexlabs/mavis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mavis",
    "ui",
    "themes",
    "vue"
  ]
