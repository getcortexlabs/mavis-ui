{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "paths": {
      "#mavis": ["./src/mavis.ts"],
      "#shared-ui/*": ["__MAVIS_SHARED_ROOT__/*"]
    }
  },
  "include": ["src", "../../shared", "vite.config.ts"]
}
