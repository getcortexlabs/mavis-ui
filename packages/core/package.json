{
  "name": "@getcortexlabs/mavis-core",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "sideEffects": false,
  "description": "Shared Mavis themes and component contracts.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@vue/runtime-core": "^3.5.42"
  },
  "peerDependenciesMeta": {
    "@vue/runtime-core": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "Rafael Augusto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcortexlabs/mavis-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://mavis-ui.getcortexlabs.com/guide/foundation",
  "bugs": {
    "url": "https://github.com/getcortexlabs/mavis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mavis",
    "ui",
    "themes",
    "vue"
  ]
}
