{
  "name": "mavis-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/catalog-web"
  ],
  "scripts": {
    "build": "npm run build --workspace @getcortexlabs/mavis-core && npm run build --workspace @getcortexlabs/mavis && npm run build --workspace @getcortexlabs/mavis-web",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p test/tsconfig.templates.json",
    "test": "vitest run",
    "check": "npm run format:check && npm run docs:build && npm run typecheck && npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run build && vitepress build docs && npm run web:build",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write packages test examples",
    "format:check": "prettier --check packages test examples",
    "web:dev": "npm run dev --workspace mavis-catalog-web",
    "web:build": "npm run build --workspace mavis-catalog-web",
    "test:web": "playwright test",
    "release:pack": "npm run build && node scripts/pack-release.mjs",
    "release:check": "node scripts/check-package-consumers.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nativescript/core": "9.1.3",
    "@playwright/test": "1.64.1",
    "@rafaelaugusto/jolt": "0.1.0-rc.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.42",
    "lucide-static": "1.65.0",
    "nativescript-vue": "3.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "^6.4.5"
  },
  "license": "MIT"
}
