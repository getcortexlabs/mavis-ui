{
  "name": "mavis-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/catalog-web"
  ],
  "scripts": {
    "build": "node scripts/build-compiler.mjs && npm run build --workspace @getcortexlabs/mavis-core && npm run build --workspace @getcortexlabs/mavis && npm run build --workspace @getcortexlabs/mavis-web && npm run build --workspace @getcortexlabs/mavis-react-nativescript && npm run build --workspace @getcortexlabs/mavis-angular-nativescript && npm run build --workspace @getcortexlabs/mavis-svelte-nativescript && npm run build --workspace @getcortexlabs/mavis-solid-nativescript",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p test/tsconfig.templates.json",
    "test": "vitest run",
    "check": "npm run format:check && npm run docs:build && npm run typecheck && npm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run build && vitepress build docs && npm run web:build",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write packages test examples",
    "format:check": "prettier --check packages test examples",
    "web:dev": "npm run dev --workspace mavis-catalog-web",
    "web:build": "npm run build --workspace mavis-catalog-web",
    "test:web": "playwright test",
    "release:pack": "npm run build && node scripts/pack-release.mjs",
    "release:check": "node scripts/check-package-consumers.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/build-compiler.mjs",
    "adapters:generate": "node scripts/generate-native-adapters.mjs"
  },
  "devDependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@nativescript-community/solid-js": "2.0.1",
    "@nativescript-community/svelte-native": "1.0.32",
    "@nativescript/angular": "22.0.2",
    "@nativescript/core": "9.1.4",
    "@playwright/test": "1.64.1",
    "@rafaelaugusto/jolt": "0.1.0-rc.17",
    "@solidjs/babel-plugin": "2.0.0",
    "@solidjs/universal": "2.0.0",
    "@types/react": "18.3.31",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.42",
    "dominative": "0.1.3",
    "lucide-static": "1.65.0",
    "nativescript-vue": "3.1.3",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-nativescript": "5.0.0",
    "solid-js": "2.0.0",
    "svelte": "4.2.20",
    "svelte-check": "3.8.6",
    "svelte2tsx": "0.7.57",
    "typescript": "^6.0.3",
    "undom-ng": "1.1.2",
    "vite": "^6.4.5",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "^6.4.5",
    "react-nativescript": {
      "@nativescript/core": "$@nativescript/core"
    },
    "@nativescript-community/svelte-native": {
      "@nativescript/core": "$@nativescript/core"
    }
  },
  "license": "MIT"
}
