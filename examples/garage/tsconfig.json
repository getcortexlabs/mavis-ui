{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": { "vue": ["./node_modules/nativescript-vue"] }
  },
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" },
  "include": ["src"]
}
