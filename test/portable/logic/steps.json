    },
    {
      "expect": ["Picked Bo; count 3", "Owner Ada 3 (36)", "Log [first;same;swap;empty;]"]
    },
    {
      "click": "Adopt"
    },
    {
      "expect": ["Picked Bo; count 3", "Owner Ada 3 (37)", "Log [first;same;swap;empty;]"]
