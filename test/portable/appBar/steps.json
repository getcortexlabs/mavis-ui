{
  "root": "Shelf",
  "covers": "MAppBar: a row on the theme's surface with the back button, the leading content, the title as a heading over its subtitle and the actions at the end; the back button runs navigateBack and then reports back; a bar with only a title",
  "steps": [
    {
      "expect": ["Library", "Left 0 times", "Not saved, told 0", "Plain"],
      "headings": ["Library", "Plain"]
    },
    {
      "layout": [
        { "of": "bar", "height": 84 },
        { "of": "save", "in": "bar", "x": "end", "y": "center", "inset": 16 },
        { "order": ["mark", "save"], "axis": "x" },
        { "sameRow": ["mark", "save"] },
        { "order": ["bar", "status", "plain"], "axis": "y" },
        { "equal": ["bar", "plain"], "size": "width" }
      ]
    },
    { "paint": "bar", "is": "surface" },
    { "paint": "plain", "is": "surface" },
    { "click": "Back to shelves" },
    { "expect": ["Library", "Left 1 times", "Not saved, told 1", "Plain"] },
    { "click": "Save" },
    { "click": "Back to shelves" },
    { "expect": ["Library", "Left 2 times", "Saved, told 2", "Plain"] }
  ]
}
