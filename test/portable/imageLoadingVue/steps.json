{
  "root": "Home",
  "covers": "Eager loads beyond the viewport; lazy waits for entry, ignores a source replaced while hidden, and keeps completed loads across leaving/reentering. NativeScript retains its existing eager interpretation of this browser hint.",
  "steps": [
    {
      "expect": ["Eager 1 / Lazy 0 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 1 / Errors 0"]
      }
    },
    {
      "click": "Switch hidden"
    },
    {
      "expect": ["Eager 1 / Lazy 0 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 2 / Errors 0"]
      }
    },
    {
      "scroll": "image-scroll",
      "by": 8500
    },
    {
      "expect": ["Eager 1 / Lazy 1 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 2 / Errors 0"]
      }
    },
    {
      "scroll": "image-scroll",
      "by": -8500
    },
    {
      "expect": ["Eager 1 / Lazy 1 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 2 / Errors 0"]
      }
    },
    {
      "click": "Switch hidden"
    },
    {
      "expect": ["Eager 1 / Lazy 1 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 3 / Errors 0"]
      }
    },
    {
      "scroll": "image-scroll",
      "by": 8500
    },
    {
      "expect": ["Eager 1 / Lazy 2 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 3 / Errors 0"]
      }
    },
    {
      "scroll": "image-scroll",
      "by": -8500
    },
    {
      "scroll": "image-scroll",
      "by": 8500
    },
    {
      "expect": ["Eager 1 / Lazy 2 / Errors 0"],
      "native": {
        "expect": ["Eager 1 / Lazy 3 / Errors 0"]
      }
    }
  ]
}
