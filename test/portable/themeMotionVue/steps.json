{
  "root": "ThemeMotion",
  "covers": "Scoped theme motion in a carousel and a persistent toast; changing theme preserves the selected slide and the shown toast, while the queue takes subsequent enter/exit timing from its actual provider.",
  "steps": [
    {
      "expect": ["Studio scenes", "First scene", "Selected one"]
    },
    {
      "click": "Next slide"
    },
    {
      "expect": ["Second scene", "Selected two"]
    },
    {
      "click": "Use night"
    },
    {
      "expect": ["Second scene", "Selected two"]
    },
    {
      "click": "Show notice"
    },
    {
      "expect": ["Theme notice"]
    },
    {
      "click": "Use daylight"
    },
    {
      "expect": ["Theme notice", "Second scene", "Selected two"]
    },
    {
      "click": "Dismiss notification"
    },
    {
      "expect": ["Second scene", "Selected two"],
      "absent": ["Theme notice"]
    },
    {
      "click": "Next slide"
    },
    {
      "expect": ["First scene", "Selected one"]
    }
  ]
}
