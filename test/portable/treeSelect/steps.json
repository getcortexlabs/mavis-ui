{
  "root": "Library",
  "covers": "MTreeSelect: the button named by what is chosen, the tree opened under it, nodes expanded and collapsed through the source's list, several nodes checked and unchecked, a node that cannot be chosen, clearing the choice, and a tree where choosing one node replaces the choice and closes the tree",
  "reducedMotion": true,
  "knownWebErrors": ["WebSurfaceConflictError"],
  "steps": [
    {
      "expect": ["Topics", "Topics: notes", "Start page", "Start: none"]
    },
    {
      "layout": [
        {
          "order": ["topics", "chosen", "start", "home"],
          "axis": "y"
        }
      ]
    },
    {
      "click": "Release notes"
    },
    {
      "click": "Expand: Guides"
    },
    {
      "toggle": "Install"
    },
    {
      "toggle": "Themes"
    },
    {
      "click": "Expand: Reference"
    },
    {
      "toggle": "Button"
    },
    {
      "click": "Collapse: Guides"
    },
    {
      "toggle": "Release notes"
    },
    {
      "click": "Install, Themes, Button"
    },
    {
      "expect": ["Topics", "Topics: install, theme, button", "Start page", "Start: none"]
    },
    {
      "click": "Install, Themes, Button"
    },
    {
      "click": "Clear topics"
    },
    {
      "click": "Choose topics"
    },
    {
      "expect": ["Topics", "Topics: none", "Start page", "Start: none"]
    },
    {
      "click": "Choose a page"
    },
    {
      "click": "Expand: Guides"
    },
    {
      "click": "Themes"
    },
    {
      "expect": ["Topics", "Topics: none", "Start page", "Start: theme"]
    },
    {
      "click": "Themes"
    },
    {
      "click": "Release notes"
    },
    {
      "expect": ["Topics", "Topics: none", "Start page", "Start: notes"]
    }
  ]
}
