{
  "root": "Lifetime",
  "covers": "component identity owns lifecycle, pending work cannot retain an unmounted child, explicit host cancellation plus shared generation guards reject late results, and remount creates a new lifetime",
  "steps": [
    {
      "expect": ["Loading", "Cancelled 0, committed 0", "Completed 0, disposed 0", "Working child"]
    },
    { "click": "Hide child" },
    { "expect": ["Cancelled", "Cancelled 1, committed 0", "Completed 0, disposed 1"] },
    { "click": "Finish pending work" },
    { "expect": ["Cancelled", "Cancelled 1, committed 0", "Completed 0, disposed 1"] },
    { "click": "Show child" },
    {
      "expect": ["Loading", "Cancelled 1, committed 0", "Completed 0, disposed 1", "Working child"]
    },
    { "click": "Finish pending work" },
    {
      "expect": ["Loaded", "Cancelled 1, committed 1", "Completed 1, disposed 1", "Working child"]
    },
    { "click": "Hide child" },
    { "expect": ["Cancelled", "Cancelled 2, committed 1", "Completed 1, disposed 2"] }
  ]
}
