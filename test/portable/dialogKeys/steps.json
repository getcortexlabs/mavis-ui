{
  "root": "Booking",
  "shared": "../dialog/shared",
  "desktop": true,
  "covers": "MDialog and the keyboard: Escape closes a dialog with its reason, and a dialog that is not dismissible stays",
  "steps": [
    {
      "click": "Book"
    },
    {
      "expect": ["Confirm booking?", "You will be charged now."],
      "layer": "modal"
    },
    {
      "press": "Escape"
    },
    {
      "expect": ["Trip to Lisbon", "Status: draft", "Last close: escape"]
    },
    {
      "click": "Delete trip"
    },
    {
      "expect": ["Delete this trip?", "This cannot be undone."],
      "layer": "modal"
    },
    {
      "press": "Escape"
    },
    {
      "expect": ["Delete this trip?", "This cannot be undone."],
      "layer": "modal"
    },
    {
      "click": "Cancel"
    },
    {
      "expect": ["Trip to Lisbon", "Status: draft", "Last close: cancel"]
    }
  ]
}
