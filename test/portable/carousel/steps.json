        "Current: ferry"
      ]
    },
    { "click": "Lock" },
    { "click": "Slide 1", "force": true },
    { "click": "Previous slide", "force": true },
    {
      "expect": [
        "Stories",
        "3 / 3",
        "The last ferry",
        "Lights on the water, all the way back.",
        "Story 3",
        "Current: ferry"
      ]
    },
    { "click": "Lock" },
    { "click": "Slide 2" },
