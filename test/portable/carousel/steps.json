      "expect": [
        "Stories",
        "3 / 3",
        "The last ferry",
        "Lights on the water, all the way back.",
        "Story 3",
        "Current: ferry"
      ]
    },
    { "click": "Next slide", "force": true },
    {
      "expect": [
        "Stories",
        "3 / 3",
        "The last ferry",
        "Lights on the water, all the way back.",
        "Story 3",
        "Current: ferry"
      ]
    },
    { "click": "Loop" },
    { "click": "Next slide" },
    {
      "expect": [
        "Stories",
        "1 / 3",
        "A walk before breakfast",
        "The street is still asleep.",
        "Story 1",
        "Current: walk"
      ]
